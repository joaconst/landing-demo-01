---
import Base from '../layouts/Base.astro';
import Spark from '../components/Spark.astro';
import Wordmark from '../components/Wordmark.astro';

const celdas: { x: number; y: number; marca: boolean }[] = [];
for (let c = 0; c < 5; c++) {
  for (let r = 2; r >= 0; r--) {
    celdas.push({ x: 14 + c * 60, y: 38 + r * 48, marca: c === 3 && r === 1 });
  }
}

const reticula: { x: number; y: number; marca: boolean }[] = [];
for (let r = 0; r < 4; r++) {
  for (let c = 0; c < 4; c++) {
    reticula.push({ x: c * 22, y: r * 22, marca: c === 2 && r === 1 });
  }
}

const paleta = [
  { nombre: 'Obsidiana', hex: '#0A0F0D', rol: 'Fondo. Casi todo el sitio.' },
  { nombre: 'Carbón', hex: '#151C18', rol: 'Tarjetas, paneles, formularios.' },
  { nombre: 'Hueso', hex: '#F3EEE4', rol: 'Texto principal y fondos claros.' },
  { nombre: 'Brasa', hex: '#C4552D', rol: 'Acento. Decide la mirada.' },
  { nombre: 'Llama', hex: '#F2A33C', rol: 'Cifras, hover y detalles.' },
  { nombre: 'Verde profundo', hex: '#123A2E', rol: 'Fondos de calma y sellos.' },
  { nombre: 'Ceniza', hex: '#8C9992', rol: 'Texto secundario y líneas.' },
  { nombre: 'Cielo', hex: '#A9C3BD', rol: 'Lecturas y estados de datos.' },
];
---

<Base
  title="PHENIX · Dirección de arte"
  description="Hoja de dirección de arte de PHENIX: marca, color, tipografía, piezas y movimiento."
  noindex
>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="nav__logo" href="#portada" aria-label="PHENIX, volver arriba">
        <Wordmark conSimbolo gradId="nav" class="marca--nav" />
      </a>
      <nav class="nav__links" aria-label="Secciones de la muestra">
        <a href="#marca">Marca</a>
        <a href="#color">Color</a>
        <a href="#letras">Letras</a>
        <a href="#piezas">Piezas</a>
      </nav>
      <a class="btn btn--sm nav__cta" href="#portada">
        Calculá mi ahorro
        <svg class="btn__flecha" viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </a>
    </div>
  </header>

  <main>
    <!-- ================= PORTADA REAL ================= -->
    <section class="hero" id="portada" data-portada>
      <div class="hero__brillo" aria-hidden="true"></div>
      <div class="hero__reticula" aria-hidden="true"></div>

      <div class="wrap hero__contenido">
        <div class="hero__firma">
          <Spark class="hero__chispa" style="width:44px;height:44px" grad id="hero" />
          <p class="eyebrow eyebrow--plano">Ingeniería solar · Argentina</p>
        </div>

        <h1 class="hero__title">
          <span class="hero__mask">
            <span class="hero__in">Tu factura no baja.<br />Tu consumo <br class="br-movil" /><em>sí</em> puede.</span>
          </span>
        </h1>

        <div class="hero__pie">
          <p class="hero__sub" data-hero-in>
            Diseñamos, instalamos y tramitamos tu sistema solar llave en mano.
            Números claros, garantía real y monitoreo incluido.
          </p>
          <div class="hero__acciones" data-hero-in>
            <a class="btn" href="#uso" data-cta>
              Calculá mi ahorro
              <svg class="btn__flecha" viewBox="0 0 16 16" aria-hidden="true" fill="none">
                <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.6" />
              </svg>
              <span class="btn__spark" aria-hidden="true"></span>
            </a>
            <a class="btn btn--ghost" href="#marca">Ver la marca</a>
          </div>
        </div>

        <p class="hero__trust" data-hero-in>
          <span>Ley 27.424</span><span>Trámite incluido</span>
        </p>

        <figure class="medidor" data-hero-panel>
          <div class="medidor__top">
            <span class="mono">Ejemplo de cálculo</span>
            <span class="tag">Casa</span>
          </div>

          <div class="medidor__cuerpo">
            <div class="medidor__plano">
              <svg viewBox="0 0 320 200" role="img" aria-label="Plano de ejemplo de un techo con quince paneles solares; uno de ellos encendido">
                <circle cx="296" cy="16" r="6" fill="none" stroke="#F2A33C" stroke-width="1.2" />
                <path d="M296 6v-3M296 29v-3M286 16h-3M309 16h-3" stroke="#F2A33C" stroke-width="1.2" stroke-linecap="round" />
                <path d="M296 24v6" stroke="rgba(243,238,228,.25)" stroke-width="1" stroke-dasharray="2 3" />

                <rect x="4" y="30" width="312" height="152" fill="none" stroke="rgba(243,238,228,.22)" stroke-width="1" />

                {celdas.map((c) => (
                  <rect
                    class:list={['celda', c.marca && 'celda--marca']}
                    x={c.x}
                    y={c.y}
                    width="52"
                    height="40"
                    rx="1"
                  />
                ))}

                <path d="M4 182h312" stroke="rgba(243,238,228,.12)" stroke-width="1" />
                <text x="4" y="196" fill="#8C9992" font-family="IBM Plex Mono, monospace" font-size="8" letter-spacing="1.4">CUBIERTA / 15 PANELES</text>
                <text x="316" y="196" text-anchor="end" fill="#8C9992" font-family="IBM Plex Mono, monospace" font-size="8" letter-spacing="1.4">N ↑</text>
              </svg>
            </div>

            <div class="medidor__datos">
              <div class="medidor__dato">
                <span class="mono">Potencia</span>
                <strong>6,4<small>kWp</small></strong>
              </div>
              <div class="medidor__dato">
                <span class="mono">Paneles</span>
                <strong>15</strong>
              </div>
              <div class="medidor__dato">
                <span class="mono">Ahorro</span>
                <strong>−62<small>%</small></strong>
              </div>
            </div>
          </div>

          <figcaption class="medidor__pie">
            <span>Ejemplo ilustrativo, no una instalación real.</span>
            <a href="/#calculadora">Calculá tu caso</a>
          </figcaption>
        </figure>

        <div class="muestra__controles">
          <button type="button" class="muestra__repetir" data-ver-de-nuevo>
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
              <path d="M13.5 8a5.5 5.5 0 1 1-1.9-4.2M13.5 2v4h-4" stroke="currentColor" stroke-width="1.4" />
            </svg>
            Ver de nuevo
          </button>
          <span class="muestra__aviso" data-aviso-rm hidden>
            Tenés activado «Reducir movimiento»: acá ves una versión sin desplazamientos.
            Apagalo para ver la animación completa.
          </span>
        </div>
      </div>
    </section>

    <!-- ================= 01 MARCA ================= -->
    <section class="seccion seccion--linea" id="marca">
      <div class="wrap">
        <p class="eyebrow" data-reveal>01 / La marca</p>
        <h2 class="h2 seccion__titulo" data-reveal>El renacer, en una chispa.</h2>
        <p class="lead seccion__bajada" data-reveal>
          PHENIX viene del fénix: lo que se apaga vuelve a encenderse. El símbolo no es un pájaro.
          Son tres alas que suben dentro de una celda: se lee como llama, como ala y como panel solar
          al mismo tiempo.
        </p>

        <div class="lockup" data-reveal>
          <Spark class="lockup__simbolo" grad id="lockup" />
          <Wordmark class="marca--l" />
          <span class="lockup__linea" aria-hidden="true"></span>
          <span class="mono lockup__nota">Energía que vuelve</span>
        </div>

        <ul class="reglas">
          <li data-reveal>
            <span class="mono">Símbolo</span>
            <p>La chispa. Funciona sola, en positivo, en negativo y a 16 píxeles.</p>
          </li>
          <li data-reveal>
            <span class="mono">Wordmark</span>
            <p>Archivo expandida, mayúsculas, tracking cerrado. Aire mínimo: la altura de la X.</p>
          </li>
          <li data-reveal>
            <span class="mono">La X</span>
            <p>La única letra con cobre. Es el punto donde la marca se enciende.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= 02 COLOR ================= -->
    <section class="seccion seccion--linea" id="color">
      <div class="wrap">
        <p class="eyebrow" data-reveal>02 / Color</p>
        <h2 class="h2 seccion__titulo" data-reveal>Ocho colores. Un solo trabajo.</h2>
        <p class="lead seccion__bajada" data-reveal>
          Ochenta por ciento oscuro y hueso. El cobre aparece poco y por eso pesa:
          cuando hay un número que importa o una decisión que tomar.
        </p>

        <ul class="paleta">
          {paleta.map((c) => (
            <li class="paleta__item" data-reveal>
              <span class="paleta__chip" style={`background:${c.hex}`} aria-hidden="true"></span>
              <span class="paleta__nombre">{c.nombre}</span>
              <span class="paleta__hex">{c.hex}</span>
              <span class="paleta__rol">{c.rol}</span>
            </li>
          ))}
        </ul>

        <p class="nota" data-reveal>
          El texto oscuro sobre cobre y el hueso sobre obsidiana están probados para leerse
          sin esfuerzo, también al sol.
        </p>
      </div>
    </section>

    <!-- ================= 03 LETRAS ================= -->
    <section class="seccion seccion--linea" id="letras">
      <div class="wrap">
        <p class="eyebrow" data-reveal>03 / Letras</p>
        <h2 class="h2 seccion__titulo" data-reveal>Técnica, no decorativa.</h2>
        <p class="lead seccion__bajada" data-reveal>
          Tres voces con un trabajo cada una. La expandida grita, la redonda explica
          y la monoespaciada mide.
        </p>

        <div class="letras">
          <article class="letra" data-reveal>
            <span class="mono letra__rol">Titulares</span>
            <p class="letra__muestra letra__muestra--display">Ascenso</p>
            <p class="letra__nota">Archivo expandida, en su peso más grueso. Titulares, cifras grandes y el logotipo.</p>
          </article>

          <article class="letra" data-reveal>
            <span class="mono letra__rol">Texto</span>
            <p class="letra__muestra letra__muestra--texto">
              Un sistema solar bien dimensionado se paga solo. Lo demás es humo.
            </p>
            <p class="letra__nota">Instrument Sans, 400 y 600. Párrafos, botones y formularios.</p>
          </article>

          <article class="letra" data-reveal>
            <span class="mono letra__rol">Datos</span>
            <p class="letra__muestra letra__muestra--mono">6,4 kWp · −62% · 3,8 años</p>
            <p class="letra__nota">IBM Plex Mono. Etiquetas, unidades y lecturas del sistema.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= 04 PIEZAS ================= -->
    <section class="seccion seccion--linea" id="piezas">
      <div class="wrap">
        <p class="eyebrow" data-reveal>04 / Piezas</p>
        <h2 class="h2 seccion__titulo" data-reveal>Un sistema que se puede dibujar.</h2>
        <p class="lead seccion__bajada" data-reveal>
          Todo sale del símbolo: la retícula de celdas, la diagonal de ascenso y el sello
          técnico. Nada es un adorno suelto.
        </p>

        <div class="piezas">
          <article class="pieza" data-reveal>
            <div class="pieza__dibujo">
              <svg viewBox="0 0 84 84" aria-hidden="true">
                {reticula.map((c) => (
                  <rect
                    x={c.x}
                    y={c.y}
                    width="18"
                    height="18"
                    fill={c.marca ? '#C4552D' : 'none'}
                    stroke={c.marca ? '#C4552D' : 'rgba(243,238,228,.3)'}
                    stroke-width="1"
                  />
                ))}
              </svg>
            </div>
            <h3 class="pieza__nombre">Retícula solar</h3>
            <p class="pieza__texto">Celdas 4 × 4 con una sola encendida. Patrón, ícono y máscara.</p>
          </article>

          <article class="pieza" data-reveal>
            <div class="pieza__dibujo">
              <svg viewBox="0 0 84 84" aria-hidden="true">
                <rect x="8" y="54" width="14" height="22" fill="rgba(243,238,228,.22)" />
                <rect x="28" y="42" width="14" height="34" fill="rgba(243,238,228,.32)" />
                <rect x="48" y="28" width="14" height="48" fill="rgba(196,85,45,.7)" />
                <rect x="68" y="12" width="14" height="64" fill="#F2A33C" />
              </svg>
            </div>
            <h3 class="pieza__nombre">Ascenso</h3>
            <p class="pieza__texto">Barras escalonadas y diagonales. Ordenan secciones y datos.</p>
          </article>

          <article class="pieza" data-reveal>
            <div class="pieza__dibujo">
              <svg viewBox="0 0 84 84" aria-hidden="true">
                <circle cx="42" cy="42" r="37" fill="none" stroke="rgba(243,238,228,.35)" stroke-width="1" />
                <circle cx="42" cy="42" r="30" fill="none" stroke="rgba(196,85,45,.55)" stroke-width="1" stroke-dasharray="2 4" />
                <text x="42" y="36" text-anchor="middle" fill="#F3EEE4" font-family="IBM Plex Mono, monospace" font-size="8.4" letter-spacing=".4">LEY 27.424</text>
                <text x="42" y="47" text-anchor="middle" fill="#8C9992" font-family="IBM Plex Mono, monospace" font-size="5.4" letter-spacing=".5">INSTALACIÓN</text>
                <text x="42" y="55" text-anchor="middle" fill="#8C9992" font-family="IBM Plex Mono, monospace" font-size="6.1" letter-spacing=".3">CERTIFICADA</text>
              </svg>
            </div>
            <h3 class="pieza__nombre">Sello</h3>
            <p class="pieza__texto">Confianza para certificaciones, garantías y legales.</p>
          </article>

          <article class="pieza" data-reveal>
            <div class="pieza__dibujo pieza__dibujo--tag">
              <span class="tag tag--brasa">Lectura en vivo</span>
              <span class="tag">Ley 27.424</span>
              <span class="tag">−62%</span>
            </div>
            <h3 class="pieza__nombre">Etiqueta técnica</h3>
            <p class="pieza__texto">Monoespaciada y en mayúsculas. Nombra el dato.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= 05 EN USO ================= -->
    <section class="seccion seccion--linea" id="uso">
      <div class="wrap">
        <p class="eyebrow" data-reveal>05 / En uso</p>
        <h2 class="h2 seccion__titulo" data-reveal>Así se ve en la mano.</h2>
        <p class="lead seccion__bajada" data-reveal>
          Bordes rectos, líneas finas y una sola cosa encendida por pantalla.
          El botón siempre dice lo mismo: calculá.
        </p>

        <div class="uso">
          <div class="uso__bloque" data-reveal>
            <span class="mono uso__rotulo">Botones</span>
            <div class="uso__fila">
              <a class="btn" href="#uso">
                Calculá mi ahorro
                <span class="btn__spark" aria-hidden="true"></span>
              </a>
              <a class="btn btn--ghost" href="#uso">Ver proyectos</a>
            </div>
            <p class="uso__nota">El principal enciende una línea de luz. El segundo no compite.</p>
          </div>

          <div class="uso__bloque" data-reveal>
            <span class="mono uso__rotulo">Tarjeta de resultado</span>
            <div class="resultado">
              <div class="resultado__top">
                <span class="tag tag--brasa">Recomendado</span>
                <span class="mono">Ejemplo</span>
              </div>
              <p class="resultado__cifra">6,4 <small>kWp</small></p>
              <div class="resultado__filas">
                <div><span>Ahorro mensual</span><strong>−62%</strong></div>
                <div><span>Generación anual</span><strong>13.846 kWh</strong></div>
              </div>
              <a class="btn" href="#uso">Calculá mi ahorro <span class="btn__spark" aria-hidden="true"></span></a>
            </div>
          </div>

          <div class="uso__bloque" data-reveal>
            <span class="mono uso__rotulo">Campo</span>
            <label class="campo">
              <span class="campo__label">Factura mensual de luz</span>
              <span class="campo__caja">
                <span class="campo__prefijo">$</span>
                <input type="text" inputmode="numeric" value="48.000" readonly aria-label="Factura mensual de ejemplo" />
                <span class="campo__unidad">ARS</span>
              </span>
            </label>
            <p class="uso__nota">Un dato por pantalla. Sin asteriscos ni letra chica.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 06 MOVIMIENTO ================= -->
    <section class="seccion seccion--linea" id="movimiento">
      <div class="wrap">
        <p class="eyebrow" data-reveal>06 / Movimiento</p>
        <h2 class="h2 seccion__titulo" data-reveal>La energía recorre el techo.</h2>
        <p class="lead seccion__bajada" data-reveal>
          La animación firma es una sola: la chispa se dibuja, la corriente cruza los paneles
          y termina encendiendo el botón. Despacio, sin rebotes, como un instrumento que se calibra.
        </p>

        <ol class="pasos">
          <li data-reveal><span class="mono">01</span><p>La chispa se dibuja y se llena de cobre.</p></li>
          <li data-reveal><span class="mono">02</span><p>Las celdas del techo se encienden en diagonal.</p></li>
          <li data-reveal><span class="mono">03</span><p>Una línea de luz aparece bajo el botón.</p></li>
        </ol>

        <div class="cierre" data-reveal>
          <p class="cierre__texto">
            Si tu sistema pide menos movimiento, la página se ve completa y quieta.
            Nada se reproduce solo.
          </p>
          <button type="button" class="btn btn--ghost" data-ver-de-nuevo>Ver la entrada otra vez</button>
        </div>
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="wrap pie__inner">
      <Wordmark conSimbolo class="marca--pie" />
      <p class="pie__nota">
        Hoja de dirección de arte · Marca de demostración · No se publica.
      </p>
    </div>
  </footer>

  <script>
    import '../scripts/marca.ts';
  </script>
</Base>

<style>
  /* ===== Navegación ===== */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 15, 13, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linea);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
  }

  .nav__links {
    display: none;
    gap: 1.6rem;
    font-size: 0.8125rem;
    color: var(--ceniza);
  }

  .nav__links a {
    padding-block: 0.5rem;
    transition: color var(--t-hover) var(--ease);
  }

  .nav__links a:hover {
    color: var(--hueso);
  }

  .nav__cta {
    flex: none;
  }

  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
  }

  /* ===== Portada ===== */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(2.5rem, 6vw, 5rem);
  }

  .hero__brillo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(120% 90% at 85% -10%, rgba(196, 85, 45, 0.3), transparent 55%),
      radial-gradient(90% 70% at 0% 100%, rgba(18, 58, 46, 0.55), transparent 60%);
  }

  .hero__reticula {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(243, 238, 228, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(243, 238, 228, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(80% 70% at 50% 15%, #000 0%, transparent 78%);
  }

  .hero__contenido {
    position: relative;
  }

  .hero__firma {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .hero__chispa {
    flex: none;
    color: var(--hueso);
  }

  .hero__title {
    font-family: var(--display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.05rem, 7.2vw, 4.6rem);
    line-height: 0.94;
    letter-spacing: -0.028em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .hero__title em {
    font-style: normal;
    color: var(--llama);
  }

  .br-movil {
    display: none;
  }

  @media (max-width: 859px) {
    .br-movil {
      display: initial;
    }
  }

  .hero__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero__in {
    display: block;
  }

  .js .hero__in {
    transform: translateY(112%);
    animation: lineaRescate 0s 12s forwards;
  }

  @keyframes lineaRescate {
    to {
      transform: none;
    }
  }

  .hero__pie {
    display: grid;
    gap: 1.4rem;
    margin-top: 1.5rem;
  }

  .hero__sub {
    max-width: 46ch;
    color: var(--ceniza);
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero__acciones .btn {
    min-height: 50px;
    padding: 0 1.05rem;
    font-size: 0.9375rem;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    margin-top: 1.5rem;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ceniza);
  }

  .hero__trust span + span::before {
    content: '·';
    margin-right: 0.7rem;
    color: var(--brasa);
  }

  @media (min-width: 860px) {
    .hero__pie {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2.5rem;
