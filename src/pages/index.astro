import Base from '../layouts/Base.astro';
import Spark from '../components/Spark.astro';
import Wordmark from '../components/Wordmark.astro';

/* --- Modelo de la calculadora (una sola fuente de verdad) --------------- */
const GEN = 1400; // kWh por kWp al año, promedio del país
const PERD = 0.12; // pérdidas de conversión y cableado
const AUTO: Record<string, number> = { casa: 0.7, comercio: 0.78, industria: 0.85 };

const inicial = { tipo: 'casa', factura: 48000, consumo: 460 };

const calcular = (factura: number, consumo: number, tipo: string) => {
  const auto = AUTO[tipo] ?? AUTO.casa;
  const anual = consumo * 12;
  const kwp = anual / (GEN * (1 - PERD) * auto);
  return {
    kwp: Math.round(kwp * 10) / 10,
    generacion: Math.round(kwp * GEN * (1 - PERD)),
    ahorro: Math.round(factura * auto * (1 - PERD)),
    pct: Math.round(auto * (1 - PERD) * 100),
  };
};

const fmt = (n: number, d = 0) =>
  new Intl.NumberFormat('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);

/* Resalta los datos que faltan completar antes de publicar. */
const marca = (s: string) => s.replace(/\[[^\]]+\]/g, (m) => `<span class="marcador">${m}</span>`);

const d = calcular(inicial.factura, inicial.consumo, inicial.tipo);

/* --- Plano del techo ---------------------------------------------------- */
const celdas: { x: number; y: number; marca: boolean }[] = [];
for (let c = 0; c < 5; c++) {
  for (let r = 2; r >= 0; r--) {
    celdas.push({ x: 14 + c * 60, y: 38 + r * 48, marca: c === 3 && r === 1 });
  }
}

const soluciones = [
  {
    id: 'casa',
    tab: 'Casa',
    titulo: 'Para bajar la factura sin cambiar tus horarios.',
    texto:
      'Un sistema dimensionado sobre tu consumo anual, no sobre un promedio. Se instala en el techo, se conecta a tu tablero y empieza a generar el mismo día.',
    datos: ['3 a 10 kWp', 'Trámite de usuario-generador', 'Monitoreo desde el celular'],
    nota: 'El excedente que no consumís se inyecta a la red y se compensa según el criterio de tu distribuidora.',
  },
  {
    id: 'comercio',
    tab: 'Comercio',
    titulo: 'Para el gasto que más pesa: el horario pico.',
    texto:
      'Diseñamos sobre tu curva de carga, no sobre la potencia del tablero. El objetivo es que la generación caiga justo en las horas en que la tarifa más duele.',
    datos: ['10 a 100 kWp', 'Informe técnico para contabilidad', 'Habilitación con la distribuidora'],
    nota: 'El dimensionado incluye análisis de demanda, factor de potencia y espacio real de cubierta.',
  },
  {
    id: 'campo',
    tab: 'Campo',
    titulo: 'Para donde la red no llega o no alcanza.',
    texto:
      'Bombeo, electrificación rural y sistemas aislados con baterías. Equipos pensados para polvo, calor y años de uso continuo.',
    datos: ['Bombeo solar', 'Sistemas aislados', 'Mantenimiento por contrato'],
    nota: 'Cada equipo se monitorea en remoto: si la generación cae, lo vemos antes de que se note en el campo.',
  },
];

const pasos = [
  { n: '01', t: 'Diagnóstico', d: 'Miramos factura, consumo y techo. Si el techo no sirve, lo decimos.' },
  { n: '02', t: 'Diseño y trámite', d: 'Memoria, planos y presentación ante la distribuidora. Vos firmás, nosotros corremos.' },
  { n: '03', t: 'Instalación', d: 'Equipo certificado, puesta en marcha y prueba de generación el mismo día.' },
  { n: '04', t: 'Monitoreo', d: 'Lecturas, alertas y mantenimiento. Si algo baja, lo vemos antes que vos.' },
];

const diferenciales = [
  {
    t: 'Dimensionado con datos',
    d: 'Usamos tu consumo de doce meses. Sin sobredimensionar para vender más paneles.',
  },
  {
    t: 'Un solo responsable',
    d: 'Diseño, trámite, instalación y monitoreo con el mismo equipo. Sin terceros en el medio.',
  },
  {
    t: 'Trámite incluido',
    d: 'Presentación, seguimiento y habilitación como usuario-generador bajo Ley 27.424.',
  },
  {
    t: 'Garantía por escrito',
    d: 'Plazos y cobertura en el contrato, no en un folleto. Condiciones: [GARANTÍA].',
  },
];

const preguntas: { id?: string; q: string; a: string }[] = [
  {
    q: '¿Cuánto tarda una instalación?',
    a: 'La obra en sí lleva [DÍAS DE OBRA]. Lo que más varía es la aprobación de la distribuidora: [PLAZO]. Te damos un cronograma por escrito antes de empezar.',
  },
  {
    q: '¿Qué pasa si la distribuidora no aprueba la conexión?',
    a: 'Revisamos la factibilidad antes de cobrar la instalación. Si el punto no es apto, no avanzamos y te explicamos por qué.',
  },
  {
    q: '¿Sirve mi techo?',
    a: 'Necesita orientación norte, sombra limitada y una estructura en condiciones. Lo verificamos en la visita técnica, con medidas y fotos.',
  },
  {
    q: '¿Qué mantenimiento necesita?',
    a: 'Limpieza y revisión una o dos veces al año. El monitoreo avisa si la generación cae, así no dependés de mirar la app todos los días.',
  },
  {
    id: 'ley-27424',
    q: '¿Cómo se compensa la energía que entrego a la red?',
    a: 'Bajo Ley 27.424, la distribuidora la reconoce como crédito en tu factura. El criterio y la tarifa de inyección los fija cada jurisdicción.',
  },
  {
    q: '¿Qué pasa si me mudo?',
    a: 'El sistema queda con el inmueble y el usuario-generador se puede transferir. El trámite de cambio de titular lo hacemos nosotros.',
  },
];
