---
interface Props {
  class?: string;
  grad?: boolean;
  id?: string;
  style?: string;
}

const { class: clase = '', grad = false, id = 'chispa', style } = Astro.props;
const relleno = grad ? `url(#grad-${id})` : 'currentColor';
---

<svg
  class={`chispa ${clase}`}
  viewBox="0 0 100 100"
  style={style}
  aria-hidden="true"
  focusable="false"
>
  {
    grad && (
      <defs>
        <linearGradient id={`grad-${id}`} x1="22%" y1="88%" x2="82%" y2="12%">
          <stop offset="0%" stop-color="#C4552D" />
          <stop offset="58%" stop-color="#E07A32" />
          <stop offset="100%" stop-color="#F2A33C" />
        </linearGradient>
      </defs>
    )
  }
  <path
    class="chispa__marco"
    d="M50 4 L96 50 L50 96 L4 50 Z"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linejoin="miter"
  />
  <path
    class="chispa__ala"
    d="M24 66 Q28 50 45 38 Q40 54 24 66 Z"
    fill={relleno}
    stroke={relleno}
    stroke-width="1"
    stroke-linejoin="round"
  />
  <path
    class="chispa__ala"
    d="M34 77 Q38 60 57 47 Q51 64 34 77 Z"
    fill={relleno}
    stroke={relleno}
    stroke-width="1"
    stroke-linejoin="round"
  />
  <path
    class="chispa__ala"
    d="M44 88 Q49 69 73 53 Q66 73 44 88 Z"
    fill={relleno}
    stroke={relleno}
    stroke-width="1"
    stroke-linejoin="round"
  />
</svg>
